orkflow ID:</td>\n                    <td style=\"padding: 8px 0;\">{{ $json.workflow.id || 'N/A' }}</td>\n                </tr>\n                <tr>\n                    <td style=\"padding: 8px 0; color: #666; font-weight: bold;\">Workflow Name:</td>\n                    <td style=\"padding: 8px 0;\">{{ $json.workflow.name || 'N/A' }}</td>\n                </tr>\n            </table>\n        </div>\n\n        <div style=\"background-color: #FFF5F5; border-left: 4px solid #DE350B; padding: 15px; margin: 20px 0;\">\n            <strong style=\"color: #DE350B; display: block; margin-bottom: 5px;\">Error Message:</strong>\n            <span style=\"font-size: 15px; font-weight: 500;\">\n            {{ $json.execution.error.message || \"Unknown Error\" }}\n            </span>\n        </div>\n        <div style=\"background-color: #FFF5F5; border-left: 4px solid #DE350B; padding: 15px; margin: 20px 0;\">\n            <strong style=\"color: #DE350B; display: block; margin-bottom: 5px;\">Execution URL:</strong>\n            <span style=\"font-size: 15px; font-weight: 500;\">\n            {{  $json.execution.url || \"Unknown URL\" }}\n            </span>\n        </div>\n\n        <p style=\"font-size: 13px; color: #666; margin-bottom: 8px;\"><strong>Raw Technical Context:</strong></p>\n        <pre style=\"background: #2D3436; color: #00D1FF; padding: 15px; border-radius: 6px; font-size: 11px; overflow-x: auto; margin: 0;\">{{ JSON.stringify( $json.execution.error, null, 2) || 'N/A' }}</pre>\n    </div>\n    \n    <div style=\"background-color: #f9f9f9; padding: 15px; text-align: center; font-size: 11px; color: #999; border-top: 1px solid #eee;\">\n        Timestamp: {{ new Date().toLocaleString() || 'N/A' }} \n    </div>\n</div>",
